# Basalt API Server 环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# 服务器端口
PORT=3001

# Solana RPC URL
# 开发网络 (推荐用于测试)
SOLANA_RPC_URL=https://api.devnet.solana.com
# 主网络 (生产环境)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# 测试网络
# SOLANA_RPC_URL=https://api.testnet.solana.com

# 前端URL (用于CORS配置)
FRONTEND_URL=http://localhost:5173

# 环境模式
NODE_ENV=development

# 服务费率 (百分比)
SERVICE_FEE_RATE=20

# API速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 日志级别
LOG_LEVEL=info
# Devnet program built on 2026-10-03
PROGRAM_ID=GRJr1pdTLEqpWRiSvvWCLZViKqxD7tiMYpPUEjUUgZin
SERVICE_FEE_BPS=50
MIN_CU_PRICE_MICROLAMPORTS=10000
MIN_CU_LIMIT=100000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional local network proxy
# HTTPS_PROXY=http://127.0.0.1:7897
SERVICE_FEE_WALLET=6TnyoYQzXqZV4Awu8kiUYX343MTAa7dTx7tLiBzcoT4Z

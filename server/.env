# Basalt API Server 环境配置

# 服务器端口
PORT=3001

# Solana RPC URL (测试网络)
SOLANA_RPC_URL=https://api.devnet.solana.com

# 前端URL (用于CORS配置)
FRONTEND_URL=http://localhost:5173

# 环境模式
NODE_ENV=development

# 服务费率 (百分比)
SERVICE_FEE_RATE=20

# API速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 日志级别
LOG_LEVEL=info

# ===== 合约模式配置 =====
# 程序ID（来源于 programs/output/basalt_inscription-keypair.json 的公钥）
PROGRAM_ID=4EVY2AhAwYXbm3bAT3onMJ1azzpzR7aURF15GehfJHjN
# 服务费接收钱包（默认与后端 index.js 中一致）
SERVICE_FEE_WALLET=6TnyoYQzXqZV4Awu8kiUYX343MTAa7dTx7tLiBzcoT4Z
# 可选：直接指定BPS（不设置则从 SERVICE_FEE_RATE*100 推导）
# SERVICE_FEE_BPS=2000
# 链上参数下限（初始化脚本默认值，可按需调整）
MIN_CU_PRICE_MICROLAMPORTS=10000
MIN_CU_LIMIT=100000
# 部署/初始化所用的签名者（默认 ~/.config/solana/id.json）
# DEPLOYER_KEYPAIR=~/.config/solana/id.json
# Basalt API Server 环境配置

# 服务器端口
PORT=3001

# Solana RPC URL (测试网络)
SOLANA_RPC_URL=https://api.devnet.solana.com

# 前端URL (用于CORS配置)
FRONTEND_URL=http://localhost:5173

# 环境模式
NODE_ENV=development

# 服务费率 (百分比)
SERVICE_FEE_RATE=20

# API速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 日志级别
LOG_LEVEL=info